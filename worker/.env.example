# Copy to worker/.env (chmod 600). Never commit .env.
PLATFORM_URL=https://portal.example.com
# Token shown ONCE when you register the worker in Worker & Processing.
WORKER_TOKEN=wkr_replace_me
WORKER_NAME=mac-mini-1
WORK_DIR=/var/lib/ipa-worker/tmp
POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=30
MAX_IPA_BYTES=2147483648
MAX_UNCOMPRESSED_BYTES=8589934592
MAX_ZIP_ENTRIES=50000
SUBPROCESS_TIMEOUT_SECONDS=60
DOWNLOAD_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO
LOG_FILE=/var/log/ipa-worker/worker.log
