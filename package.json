{
  "name": "ios-distribution-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate:local": "wrangler d1 migrations apply ipa-platform-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply ipa-platform-prod --remote --env production",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --env production",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "worker:test": "cd worker && python3 -m unittest discover -s tests -v",
    "smoke": "node scripts/smoke.mjs",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run worker:test",
    "cf:logs": "wrangler tail --env production",
    "dev:worker-api": "wrangler dev --port 8799 --ip 127.0.0.1",
    "cf:deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@tanstack/react-query": "^5.108.1",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.86.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
